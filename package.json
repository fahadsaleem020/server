{
  "name": "express-app",
  "version": "1.0.0",
  "author": "Fahad",
  "repository": "https://github.com/fahadsaleem020/express-app.git",
  "scripts": {
    "dev": "tsx watch --include \"src/**\" src/server.ts",
    "build": "tsc && tsc-alias && npm run db:generate",
    "start": "node dist/server.js && npm run db:generate",
    "lint": "biome check --write",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:introspect": "drizzle-kit introspect",
    "tailwind": "npx @tailwindcss/cli -i ./public/input.css -o ./public/output.css --watch"
  },
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@scalar/api-reference": "^1.52.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@getbrevo/brevo": "^5.0.4",
    "@google-cloud/dialogflow": "^7.5.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/express-api-reference": "^0.9.8",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.5",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "iron-session": "^8.0.4",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.0.0",
    "socket.io": "^4.8.3",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  }
}
